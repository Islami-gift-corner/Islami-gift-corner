# ============================================================
# নতুন প্রতিষ্ঠানের জন্য: এই ফাইলটা কপি করে .env.local নাম দিন, তারপর মান বসান।
#   cp .env.example .env.local
# Vercel/Netlify এ ডিপ্লয় করলে একই ভ্যারিয়েবলগুলো তাদের Environment Variables এ দিন।
# ============================================================

# ---------- ব্র্যান্ড ----------
NEXT_PUBLIC_BRAND_NAME=আমার ব্যবসা
NEXT_PUBLIC_BRAND_SHORT_NAME=আমার ব্যবসা
NEXT_PUBLIC_BRAND_DESCRIPTION=ব্যবসা ম্যানেজমেন্ট অ্যাপ
# ইংরেজি ছোট হাতের অক্ষর, স্পেস ছাড়া (ব্যাকআপ ফাইলের নাম ইত্যাদিতে লাগে)
NEXT_PUBLIC_BRAND_SLUG=my-business
# মূল রঙ — বাকি সব শেড নিজে থেকে তৈরি হবে (যেমন নীল: #1D4ED8, কমলা: #EA580C)
NEXT_PUBLIC_THEME_COLOR=#0F7938
# ডিফল্ট লোগোর পাথ (public ফোল্ডারে ফাইল বদলালে এটা না বদলালেও চলবে)
NEXT_PUBLIC_BRAND_LOGO=/logo.svg

# ---------- Firebase (Project settings > Your apps > Web app থেকে) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
